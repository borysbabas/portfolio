# --- GitHub ---
# Server-side only. Read by /api/github/repos to raise the API rate limit.
# Must NOT be prefixed with NUXT_PUBLIC_: that would expose it to the browser.
# A fine-grained token with public read access is sufficient.
GITHUB_TOKEN=

# --- Stash (the private /stash page) ---
# Sign-in password. Long: a wrong guess only costs a delay until the lockout kicks in.
STASH_PASSWORD=
# Signs the sign-in cookie and the "stop reminding me" links. 32+ characters:
# openssl rand -base64 48
STASH_SECRET=
# Vercel Cron sends this to /api/stash/reminders so the endpoint knows the call is real.
CRON_SECRET=
# Claude reads saved links into cards.
ANTHROPIC_API_KEY=
# Where reminders go. Defaults to info@borysbabas.dev.
STASH_EMAIL=
# Already on the Vercel project through the Supabase and Resend integrations.
DB_SUPABASE_URL=
DB_SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
